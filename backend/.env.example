DATABASE_URL=postgresql://postgres:Intrend1675@localhost:5432/logiverse3_db
JWT_ACCESS_SECRET=Intrend1675-lifeverse-access-secret-jwt
JWT_REFRESH_SECRET=Intrend1675-lifeverse-refresh-secret-jwt
PORT=4000
NODE_ENV=development
DEBUG=true

# 素材库图片现在存在本机磁盘（backend/uploads/assets/），数据库只存网址。
# ASSET_BASE_URL 决定这个网址前面接的是哪个域名——本机开发默认就是后端自己
# （http://localhost:4000），部署到正式环境时改成真正对外的域名（比如
# https://api.yourschool.com）。以后如果要换成真正的远端储存（S3之类的），
# 把这个改成那个储存服务的公开网址，backend/src/utils/assetStorage.ts 是
# 唯一需要改实现的地方。
ASSET_BASE_URL=http://localhost:4000